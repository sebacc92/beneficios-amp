{
  "name": "my-qwik-empty-starter",
  "description": "Blank project with routing included",
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "pnpm build && wrangler deploy --profile indesign --env-file /dev/null",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "test:ux": "node scripts/tests/map-benefits.mjs && node scripts/tests/coupons.mjs && node scripts/tests/notifications.mjs && node scripts/tests/benefit-filters.mjs",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik",
    "serve": "wrangler dev",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-interface CloudflareEnv --env-file /dev/null",
    "deploy:dry-run": "wrangler deploy --dry-run --env-file /dev/null"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.19.2",
    "@builder.io/qwik-city": "1.20.0",
    "@eslint/js": "^9",
    "@qwik-ui/headless": "^0.7.4",
    "@qwikest/icons": "^0.0.13",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "20.19.0",
    "@types/qrcode": "1.5.6",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.32.0",
    "eslint-plugin-qwik": "^1.19.2",
    "globals": "16.4.0",
    "nx": "^22.7.2",
    "postcss": "^8.5.15",
    "prettier": "3.6.2",
    "tailwindcss": "^4.3.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.38.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vercel": "^54.9.1",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "^4.2.1",
    "wrangler": "4.151.1"
  },
  "nx": {},
  "dependencies": {
    "@libsql/client": "0.17.3",
    "@noble/hashes": "2.4.0",
    "@vercel/blob": "^2.4.0",
    "drizzle-orm": "^0.45.2",
    "openai": "^6.39.0",
    "qrcode": "1.5.4"
  },
  "packageManager": "pnpm@12.4.1"
}
