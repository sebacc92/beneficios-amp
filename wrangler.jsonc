{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beneficios-lprc",
  "account_id": "bcbac71e966ee9b5a273922d06ac70f5",
  "main": "./dist/_worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "beneficios.lprc.com.ar", "custom_domain": true },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": ["/media/*"],
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "beneficios-lprc-media",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
